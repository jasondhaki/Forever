# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
# optional, defaults to "forever"
MONGODB_DB=forever
# long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
ADMIN_EMAIL=admin@forever.com
ADMIN_PASSWORD=
# deployed frontend URL(s), comma-separated; used for CORS and Stripe redirects
FRONTEND_URL=http://localhost:5173
CURRENCY=usd
# optional payment providers - leave blank to disable
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
